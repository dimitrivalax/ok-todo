{
  "name": "ok-todo",
  "private": true,
  "version": "0.0.1",
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test.e2e": "CYPRESS_EXCLUDE_A11Y=1 cypress run",
    "test.a11y": "cypress run --spec cypress/e2e/accessibility.cy.ts",
    "test.unit": "vitest --project=unit",
    "test-storybook": "vitest run --project=storybook",
    "lint": "eslint .",
    "android:bundle": "pnpm build && npx cap sync android && cd android && ./gradlew bundleRelease",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/status-bar": "^8.0.3",
    "@ionic/core": "^9.0.5",
    "@ionic/react": "^9.0.5",
    "@ionic/react-router": "^9.0.5",
    "date-fns": "^4.4.0",
    "i18next": "^26.3.1",
    "ionicons": "^8.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-router": "^6.30.6",
    "react-router-dom": "^6.30.6",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^9.39.4",
    "@rollup/rollup-darwin-arm64": "^4.62.2",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-legacy": "^8.0.2",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser-playwright": "^4.1.11",
    "axe-core": "^4.13.0",
    "cypress": "^15.17.0",
    "cypress-axe": "^1.7.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "^10.6.1",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "storybook": "^10.6.1",
    "terser": "^5.48.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  },
  "description": "A simple Todo List Application"
}
